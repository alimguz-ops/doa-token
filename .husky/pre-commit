#!/bin/sh
echo "🔍 Ejecutando verificación pre-commit..."

STAGED=$(git diff --cached --name-only)

# --- Bloquear si alguien intenta commitear .env ---
if echo "$STAGED" | grep -q "^\.env$"; then
  echo "❌ ERROR: Intentas commitear un archivo .env. Bloqueado."
  exit 1
fi

# --- Bloquear si alguien intenta commitear archivos de OpenZeppelin ---
if echo "$STAGED" | grep -q "^\.openzeppelin"; then
  echo "❌ ERROR: Intentas commitear archivos de .openzeppelin. Bloqueado."
  exit 1
fi

# --- Bloquear si hay claves privadas reales en los archivos staged ---
for FILE in $STAGED; do
  [ "$FILE" = ".gitignore" ] && continue
  [ -f "$FILE" ] || continue

  if grep -Eiq "0x[a-fA-F0-9]{64}" "$FILE"; then
    echo "❌ ERROR: El archivo $FILE contiene una clave privada real. Commit bloqueado."
    exit 1
  fi
done

# --- Verificación especial del archivo .env local ---
SECRET_PHRASE="TU_FRASE_PERSONAL"   # <-- tu clave personal
LOCK_HASH=$(grep HASH .env.lock | cut -d'=' -f2)

if [ -f ".env" ]; then
  ACTUAL_HASH=$(sha256sum .env | awk '{print $1}')
  if [ "$ACTUAL_HASH" != "$LOCK_HASH" ]; then
    echo "❌ El archivo .env no coincide con el candado. Commit bloqueado."
    exit 1
  fi

  echo "⚠️ Archivo .env detectado localmente."
  echo "👉 Ingresa tu frase personal para verificar:"
  read -r INPUT
  if [ "$INPUT" != "$SECRET_PHRASE" ]; then
    echo "❌ Frase incorrecta. Commit bloqueado."
    exit 1
  else
    echo "✅ Verificación correcta. Tú eres el propietario autorizado."
  fi
fi

echo "✅ Pre-commit check passed. No secretos encontrados."
exit 0
