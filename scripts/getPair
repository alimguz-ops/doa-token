const { ethers } = require("hardhat");

async function main() {
  const FACTORY_ADDRESS = process.env.FACTORY_ADDRESS;
  const tokenA = process.env.TOKEN_A;
  const tokenB = process.env.TOKEN_B;

  if (!FACTORY_ADDRESS || !ethers.isAddress(FACTORY_ADDRESS)) {
    throw new Error(`❌ FACTORY_ADDRESS inválido: ${FACTORY_ADDRESS}`);
  }
  if (!tokenA || !ethers.isAddress(tokenA)) {
    throw new Error(`❌ TOKEN_A inválido: ${tokenA}`);
  }
  if (!tokenB || !ethers.isAddress(tokenB)) {
    throw new Error(`❌ TOKEN_B inválido: ${tokenB}`);
  }

  console.log("🏭 Factory address:", FACTORY_ADDRESS);

  // ABI mínimo para UniswapV2Factory
  const factoryAbi = [
    "function getPair(address tokenA, address tokenB) external view returns (address pair)"
  ];

  const provider = ethers.provider;
  const factory = new ethers.Contract(FACTORY_ADDRESS, factoryAbi, provider);

  try {
    const pairAddress = await factory.getPair(tokenA, tokenB);
    if (pairAddress === ethers.ZeroAddress) {
      console.log("⚠️ No existe par para esos tokens.");
    } else {
      console.log("✅ Par encontrado:", pairAddress);
    }
  } catch (err) {
    console.error("❌ Error al llamar getPair:", err);
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});