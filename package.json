{
  "name": "doa-token",
  "version": "1.0.0",
  "description": "DOA es un token diseñado para gobernanza, liquidez y expansión de aplicaciones descentralizadas.",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy-proxy:polygon": "hardhat run scripts/deployProxy.js --network polygon",
    "deploy:sepolia": "hardhat run scripts/deployProxyDoaTokenV2.js --network sepolia",
    "verify:amoy": "hardhat run scripts/verify.js --network amoy",
    "verify:polygon": "hardhat run scripts/verify.js --network polygon",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "verify-impl:polygon": "hardhat run scripts/verify-impl.js --network polygon",
    "verify-proxy:polygon": "hardhat run scripts/verify-proxy.js --network polygon",
    "add-liquidity:polygon": "hardhat run scripts/addLiquidity.js --network polygon",
    "distribute:polygon": "hardhat run scripts/distribute.js --network polygon",
    "upgrade:polygon": "hardhat run scripts/upgrade.js --network polygon",
    "wrap:polygon": "hardhat run scripts/wrapMatic.js --network polygon",
    "prepare": "husky",
    "precommit-check": "node scripts/precommit-check.js",
    "supply": "node scripts/checkTotalSupply.js",
    "pools": "node scripts/checkPools.js",
    "pools:all": "node scripts/checkPoolsAll.js",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write .",
    "validate:tokenlist": "node scripts/validateTokenList.js",
    "monitor": "node monitor-liquidez.cjs",
    "monitor:polygon": "node monitor-liquidez.cjs",
    "monitor:eth": "MONITOR_ENABLED=true node monitor-liquidez.cjs",
    "audit": "node scripts/auditoriaDiaria.js",
    "plots": "node scripts/plotAllBalances.js",
    "audit:plots": "node scripts/auditAndPlots.js",   
    "clean:logs": "node scripts/cleanLogs.js",
    "verify:logs": "node scripts/verifyLogs.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@openzeppelin/contracts": "5.0.0",
    "@openzeppelin/contracts-upgradeable": "5.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v5": "10.2.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "7.0.0",
    "@types/chai": "4.3.10",
    "@types/mocha": "10.0.0",
    "@uniswap/token-lists": "^1.0.0-beta.35",
    "chai": "4.3.10",
    "dotenv": "^17.2.3",
    "eslint": "8.56.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.0",
    "hardhat-contract-sizer": "2.10.1",
    "hardhat-gas-reporter": "1.0.10",
    "husky": "9.1.7",
    "mocha": "10.2.0",
    "prettier": "3.2.5",
    "solidity-coverage": "0.8.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typechain": "8.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "fs-extra": "^11.2.0"
  }
}
