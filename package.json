{
  "name": "doa-token",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy-proxy:polygon": "hardhat run scripts/deployProxy.js --network polygon",
    "verify:amoy": "hardhat run scripts/verify.js --network amoy",
    "verify:polygon": "hardhat run scripts/verify.js --network polygon",
    "verify-impl:polygon": "hardhat run scripts/verify-impl.js --network polygon",
    "verify-proxy:polygon": "hardhat run scripts/verify-proxy.js --network polygon",
    "add-liquidity:polygon": "hardhat run scripts/addLiquidity.js --network polygon",
    "distribute:polygon": "hardhat run scripts/distribute.js --network polygon",
    "upgrade:polygon": "hardhat run scripts/upgrade.js --network polygon",
    "wrap:polygon": "hardhat run scripts/wrapMatic.js --network polygon",
    "prepare": "husky",
    "precommit-check": "node scripts/precommit-check.js",
    "supply": "node scripts/checkTotalSupply.js",
    "pools": "node scripts/checkPools.js",
    "pools:all": "node scripts/checkPoolsAll.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.0",
    "@openzeppelin/hardhat-upgrades": "^1.26.0",
    "@typechain/ethers-v6": "^0.4.0",
    "@typechain/hardhat": "^8.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.2.0",
    "dotenv": "^16.6.1",
    "ethers": "^5.8.0",
    "hardhat": "^2.28.0",
    "hardhat-gas-reporter": "^1.0.8",
    "husky": "^9.1.7",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "ajv": "^8.17.1"
  },
  "description": "DOA es un token diseñado para gobernanza, liquidez y expansión de aplicaciones descentralizadas.",
